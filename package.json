{
  "name": "komvos",
  "version": "1.0.0",
  "description": "Komvos Discord bot monorepo - cross-server moderation network",
  "private": true,
  "scripts": {
    "app:monitor": "pnpm --filter @komvos/bot app:monitor",
    "app:reload": "pnpm --filter @komvos/bot app:reload",
    "app:restart": "pnpm --filter @komvos/bot app:restart",
    "app:start": "pnpm --filter @komvos/bot app:start",
    "app:stop": "pnpm --filter @komvos/bot app:stop",
    "app:start:dev": "pnpm --filter @komvos/bot app:start:dev",
    "build": "pnpm -r build",
    "build:watch": "pnpm --filter @komvos/bot build:watch",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "prettify": "pnpm -r prettify"
  },
  "keywords": [
    "monorepo",
    "bot",
    "cross-server",
    "discord",
    "discord.js",
    "moderation",
    "networking"
  ],
  "author": "Ioannis Tziligkakis",
  "license": "UNLICENSED",
  "devDependencies": {
    "@babel/eslint-parser": "^7.25.1",
    "@types/node": "^22.5.4",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "better-logging": "^4.4.0",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
